# ---- Database ----
DB_NAME=certguard
DB_USER=certguard
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
# host port for MySQL when running the backend outside Docker
DB_PUBLISH_PORT=3317

# ---- Security ----
# at least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_HOURS=24

# ---- Email (Gmail SMTP) ----
# MAIL_PASSWORD must be a 16-character Gmail *App Password*, not your normal Gmail password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=
MAIL_FROM_NAME=CertGuard

# ---- Scheduler ----
# Spring cron: second minute hour day-of-month month day-of-week
EXPIRY_CHECK_CRON="0 0 8 * * *"
APP_TIMEZONE=Asia/Kolkata
DEFAULT_REMINDER_DAYS=30,15,7,1

# ---- Web ----
# used for the "Open in CertGuard" link inside reminder emails
FRONTEND_URL=http://localhost:5180
FRONTEND_PORT=5180
FRONTEND_BIND=0.0.0.0
BACKEND_PUBLISH_PORT=8188

# create demo@certguard.local / Demo@1234 with 5 sample certificates on first start
SEED_DEMO=true
